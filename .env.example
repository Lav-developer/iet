# Production deployment requires every value marked REQUIRED.
DATABASE_URL=""
AUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"
NEXT_PUBLIC_SITE_URL="https://iet.example.ac.in"

# S3-compatible object storage. REQUIRED in production.
STORAGE_ENDPOINT="https://s3.example.ac.in"
STORAGE_BUCKET="iet-dsmnru-production"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Local development only. Keep all of these unset/false in production.
ALLOW_DEMO_AUTH="false"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
ALLOW_LOCAL_SEED="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional analytics configuration. Use only an institution-owned account.
NEXT_PUBLIC_ANALYTICS_ID=""
