# Production deployment requires every value marked REQUIRED.
DATABASE_URL=""
AUTH_SECRET="generate-a-random-secret-at-least-32-characters-long"
NEXT_PUBLIC_SITE_URL="https://iet.example.ac.in"

# S3-compatible object storage. REQUIRED in production.
STORAGE_ENDPOINT="https://s3.example.ac.in"
STORAGE_BUCKET="iet-dsmnru-production"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Trusted reverse proxy (REQUIRED for correct per-client rate limiting and
# audit IP attribution in production). See docs/DEPLOYMENT.md,
# "Trusted reverse proxy configuration".
# TRUSTED_PROXY_COUNT = number of trusted proxies/load balancers in front of
# the app (each must append the peer address to X-Forwarded-For).
# TRUSTED_PROXY_CIDRS = comma-separated CIDRs covering those proxies.
# Leave TRUSTED_PROXY_COUNT unset/0 only when the app is intentionally
# directly exposed; then all clients share one coarser rate-limit bucket per
# scope and no forwarded header is ever trusted.
TRUSTED_PROXY_COUNT="1"
TRUSTED_PROXY_CIDRS="10.0.0.0/8"

# Local development only. Keep all of these unset/false in production.
ALLOW_DEMO_AUTH="false"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
ALLOW_LOCAL_SEED="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional analytics configuration. Use only an institution-owned account.
NEXT_PUBLIC_ANALYTICS_ID=""
